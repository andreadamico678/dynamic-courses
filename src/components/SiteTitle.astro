---
import { getCourseContext, MASTER_PROGRAM_LABEL } from '../lib/courseRegistry.mjs';

const scope = process.env.COURSE_SCOPE || 'all';
const ctx = getCourseContext(Astro.url.pathname, scope);
---

<div class="dc-site-brand sl-flex">
  <a href="/dynamic-courses/" class="site-title sl-flex">
    <span translate="no">Dynamic Courses</span>
  </a>
  {ctx.layer === 'bachelor' && (
    <>
      <span class="dc-brand-sep" aria-hidden="true">/</span>
      <a href="/dynamic-courses/#bachelor" class="dc-brand-layer">Bachelor</a>
      <span class="dc-brand-sep" aria-hidden="true">/</span>
      <a href={ctx.prefix} class="dc-brand-course">{ctx.label}</a>
    </>
  )}
  {ctx.layer === 'master-hub' && (
    <>
      <span class="dc-brand-sep" aria-hidden="true">/</span>
      <a href="/dynamic-courses/master/" class="dc-brand-course">{MASTER_PROGRAM_LABEL}</a>
    </>
  )}
  {ctx.layer === 'master-course' && (
    <>
      <span class="dc-brand-sep" aria-hidden="true">/</span>
      <a href="/dynamic-courses/master/" class="dc-brand-layer">Master (SDU)</a>
      <span class="dc-brand-sep" aria-hidden="true">/</span>
      <a href={ctx.prefix} class="dc-brand-course">{ctx.label}</a>
    </>
  )}
</div>

<style>
  .dc-site-brand {
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
  }
  .site-title {
    align-items: center;
    gap: var(--sl-nav-gap);
    font-size: var(--sl-text-h4);
    font-weight: 600;
    color: var(--sl-color-text-accent);
    text-decoration: none;
    white-space: nowrap;
  }
  .dc-brand-sep {
    color: var(--sl-color-gray-4);
    font-weight: 400;
    user-select: none;
  }
  .dc-brand-layer {
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--dc-muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .dc-brand-layer:hover {
    color: var(--sl-color-text-accent);
  }
  .dc-brand-course {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--dc-ink);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .dc-brand-course:hover {
    color: var(--sl-color-text-accent);
  }
  @media (max-width: 44rem) {
    .dc-brand-layer,
    .dc-brand-layer + .dc-brand-sep {
      display: none;
    }
  }
  @media (max-width: 36rem) {
    .dc-brand-sep,
    .dc-brand-course {
      display: none;
    }
  }
</style>
